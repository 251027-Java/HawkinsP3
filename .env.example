# Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=pilotquiz
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost

# JWT Secret
JWT_SECRET=your_jwt_secret_here_min_256_bits

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Docker Hub (for CI/CD)
DOCKER_HUB_USERNAME=your_dockerhub_username
DOCKER_HUB_PASSWORD=your_dockerhub_password

# AWS (for deployment)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
EC2_APP_HOST=your_ec2_app_server_ip
EC2_BUILD_HOST=your_ec2_build_server_ip
