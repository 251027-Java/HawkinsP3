# Kubernetes Secrets Template
# Copy to secrets.yaml and fill in actual values
# Apply with: kubectl apply -f secrets.yaml

# Database Secrets (for RDS)
apiVersion: v1
kind: Secret
metadata:
  name: rds-credentials
  namespace: pilotquiz-backend
type: Opaque
stringData:
  # Single RDS instance with 3 databases
  RDS_HOST: "your-rds-endpoint.region.rds.amazonaws.com"
  RDS_PORT: "5432"
  RDS_USERNAME: "pilotquiz"
  RDS_PASSWORD: "your-secure-password"
  
  # Database-specific connection strings
  USER_DB_URL: "jdbc:postgresql://your-rds-endpoint:5432/userdb"
  QUIZ_DB_URL: "jdbc:postgresql://your-rds-endpoint:5432/quizdb"
  PROGRESS_DB_URL: "jdbc:postgresql://your-rds-endpoint:5432/progressdb"
---
# JWT Secret (must match across Gateway and User Service)
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secret
  namespace: pilotquiz-backend
type: Opaque
stringData:
  JWT_SECRET: "your-256-bit-secret-key-for-jwt-signing-min-32-chars"
  JWT_EXPIRATION: "86400000"
---
# ELK Stack Configuration (for Filebeat)
apiVersion: v1
kind: Secret
metadata:
  name: elk-credentials
  namespace: pilotquiz-monitoring
type: Opaque
stringData:
  LOGSTASH_HOST: "your-elk-ec2-ip"
  LOGSTASH_PORT: "5044"
