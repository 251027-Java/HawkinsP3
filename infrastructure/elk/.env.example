# ELK Stack Environment Variables
# Copy to .env and fill in your values

# AWS S3 Configuration for Elasticsearch Snapshots
# Option 1: Use access keys (for testing)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Option 2: Use EC2 Instance Role (recommended for production)
# Leave the above empty and attach an IAM role to your EC2 instance

# S3 Bucket Configuration
S3_BUCKET=pilotquiz-elk-logs
AWS_REGION=us-east-1

# Elasticsearch Host (for scripts)
ES_HOST=localhost:9200

# Environment Tag
ENVIRONMENT=dev
